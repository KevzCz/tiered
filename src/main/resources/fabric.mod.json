{
  "schemaVersion": 1,
  "id": "tiered_more",
  "version": "${version}",
  "name": "Tiered More",
  "description": "Adds tiers to tools & accessories.",
  "authors": [
    "KevzCz",
    "Draylar",
    "Globox_Z"
  ],
  "contact": {
    "issues": "https://github.com/KevzCz/tiered.git",
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/tiered-more"
  },
  "license": "MIT",
  "icon": "assets/tiered/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "draylar.tiered.Tiered"
    ],
    "client": [
      "draylar.tiered.TieredClient"
    ],
    "modmenu": [
      "draylar.tiered.config.ModMenuIntegration"
    ],
    "server": [
      "draylar.tiered.TieredServer"
    ]
  },
  "mixins": [
    "tiered.mixins.json"
  ],
  "depends": {
    "java": ">=21",
    "minecraft": ">=${minecraft_version}",
    "fabric-api": ">=${fabric_version}",
    "fabricloader": ">=${loader_version}",
    "cloth-config2": ">=${cloth_config_version}"
  },
  "suggests": {
    "accessories": "*"
  },
  "breaks": {
    "tiered" : "*"
  }
}